{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(learn|exams|library|tools|diet-planner|case-studies|careers|dashboard|about)", "dest": "/$1.html" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1.html" }
  ]
}
