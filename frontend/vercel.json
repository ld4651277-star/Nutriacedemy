{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(learn|exams|library|tools|diet-planner|case-studies|careers|dashboard|about)", "destination": "/$1.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
