{
  "name": "nutriacademy-platform",
  "version": "1.0.0",
  "description": "NutriAcademy - Digital Nutrition & Dietetics Education Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:backend",
    "test": "node -e \"console.log('Validating server...'); require('./backend/server.js'); process.exit(0);\""
  },
  "keywords": [
    "nutriacademy",
    "nutrition",
    "dietetics",
    "education",
    "fullstack",
    "express"
  ],
